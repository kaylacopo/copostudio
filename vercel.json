{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/services/exhibition-stand-design",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/stands/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    }
  ]
}
